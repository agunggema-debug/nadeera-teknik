# Supabase — salin file ini menjadi `.env` lalu isi nilainya:
#   - Ambil dari Supabase Dashboard → Settings → API
#   - PUBLIC_SUPABASE_URL    = Project URL (mis. https://abcdefgh.supabase.co)
#   - PUBLIC_SUPABASE_ANON_KEY = anon/public key (aman dipakai di front-end)
#
# Kunci "anon" bersifat publik dan hanya boleh membaca/menulis sesuai aturan
# Row Level Security (RLS) yang dipasang (lihat SETUP_SUPABASE.md).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=