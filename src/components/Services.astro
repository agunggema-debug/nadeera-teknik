---
import { formatRupiah, waLink } from '../site';
import { DEFAULT_CONTENT, type SiteContent } from '../lib/default-content';

interface Props {
  /** Seksi layanan — opsional, fallback ke DEFAULT_CONTENT.services */
  content?: SiteContent['services'];
}
const c = Astro.props.content ?? DEFAULT_CONTENT.services;
const services = c.items;
---

<section id="layanan" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-widest text-electric-500">{c.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-cool-900 sm:text-4xl">
        {c.title}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-cool-700">
        {c.subtitle}
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service) => (
          <article class="group flex flex-col rounded-3xl border border-cool-100 bg-cool-50/60 p-6 transition hover:-translate-y-1 hover:border-electric-200 hover:bg-white hover:shadow-xl hover:shadow-electric-900/5">
            <img
              src={service.image}
              alt={service.title}
              width="48"
              height="48"
              loading="lazy"
              decoding="async"
              class="h-12 w-12"
            />
            <h3 class="mt-5 text-lg font-bold text-cool-900">{service.short}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-cool-600">{service.desc}</p>
            <p class="mt-4 text-sm font-semibold text-cool-700">
              {c.pricePrefix} <span class="font-extrabold text-electric-600">{formatRupiah(service.priceStart)}</span>
            </p>
            <a
              href={waLink(`Halo Nadeera Teknik, saya mau tanya layanan ${service.title}.`) }
              target="_blank"
              rel="noopener"
              class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-electric-600 transition group-hover:gap-2.5 hover:text-electric-700"
            >
              {c.ctaLabel}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>