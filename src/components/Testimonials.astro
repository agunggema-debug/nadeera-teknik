---
import { TESTIMONIALS } from '../site';

const gallery = [
  { src: '/images/gallery-teknisi.svg', alt: 'Teknisi Nadeera Teknik sedang menangani unit AC', label: 'Servis rutin' },
  { src: '/images/gallery-pasang.svg', alt: 'Proses pemasangan unit AC baru', label: 'Instalasi baru' },
  { src: '/images/gallery-cuci.svg', alt: 'Pembersihan unit AC indoor', label: 'Cuci AC' },
];

function stars(n: number) {
  return '★'.repeat(n) + '☆'.repeat(5 - n);
}
---

<!-- Testimoni -->
<section id="testimoni" class="bg-electric-50 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-electric-500">Testimoni Pelanggan</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-cool-900 sm:text-4xl">
        Dipercaya pelanggan di Bandung Raya
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-cool-700">
        Kepuasan pelanggan adalah bukti kualitas kami.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        TESTIMONIALS.map((t) => (
          <figure class="flex flex-col rounded-3xl border border-white bg-white p-6 shadow-sm">
            <span class="text-base text-accent-500" aria-label={`Rating ${t.star} dari 5 bintang`}>
              {stars(t.star)}
            </span>
            <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-cool-700">
              "{t.text}"
            </blockquote>
            <figcaption class="mt-5 flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-electric-100 font-bold text-electric-700">
                {t.name.charAt(0)}
              </span>
              <div>
                <p class="text-sm font-bold text-cool-900">{t.name}</p>
                <p class="text-xs text-cool-600">{t.role}</p>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<!-- Portofolio -->
<section id="portofolio" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-xl">
        <p class="text-sm font-bold uppercase tracking-widest text-electric-500">Portofolio</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-cool-900 sm:text-4xl">
          Pengerjaan yang rapi &amp; profesional
        </h2>
      </div>
      <p class="text-sm text-cool-600">Sebagian dokumentasi pekerjaan tim kami.</p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        gallery.map((g) => (
          <figure class="group overflow-hidden rounded-3xl border border-cool-100 shadow-sm">
            <div class="relative overflow-hidden">
              <img
                src={g.src}
                alt={g.alt}
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-electric-950/80 to-transparent px-5 pb-4 pt-10 text-sm font-bold text-white">
                {g.label}
              </figcaption>
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>