---
import { DEFAULT_CONTENT, type SiteContent } from '../lib/default-content';

interface Props {
  /** Seksi testimoni — opsional, fallback ke DEFAULT_CONTENT.testimonials */
  content?: SiteContent['testimonials'];
  /** Seksi portofolio — opsional, fallback ke DEFAULT_CONTENT.portfolio */
  portfolio?: SiteContent['portfolio'];
}
const c = Astro.props.content ?? DEFAULT_CONTENT.testimonials;
const p = Astro.props.portfolio ?? DEFAULT_CONTENT.portfolio;
const gallery = p.items;

function stars(n: number) {
  return '★'.repeat(n) + '☆'.repeat(5 - n);
}

// Kelompokkan gambar portofolio berdasarkan awalan nama file (tanpa ekstensi &
// tanpa angka urut di akhir), sehingga gambar dengan kategori sama (mis.
// pemasangan_ac1..7) bisa dinavigasi satu-per-satu di dalam popup.
function groupKey(src: string): string {
  const name = src.split('/').pop() ?? src;
  const base = name.replace(/\.[^.]+$/, ''); // buang ekstensi
  return base.replace(/[\s_]+/g, '_').replace(/\d+$/, '').toLowerCase();
}
---

<!-- Testimoni -->
<section id="testimoni" class="bg-electric-50 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-electric-500">{c.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-cool-900 sm:text-4xl">
        {c.title}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-cool-700">
        {c.subtitle}
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        c.items.map((t) => (
          <figure class="flex flex-col rounded-3xl border border-white bg-white p-6 shadow-sm">
            <span class="text-base text-accent-500" aria-label={`Rating ${t.star} dari 5 bintang`}>
              {stars(t.star)}
            </span>
            <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-cool-700">
              "{t.text}"
            </blockquote>
            <figcaption class="mt-5 flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-electric-100 font-bold text-electric-700">
                {t.name.charAt(0)}
              </span>
              <div>
                <p class="text-sm font-bold text-cool-900">{t.name}</p>
                <p class="text-xs text-cool-600">{t.role}</p>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<!-- Portofolio -->
<section id="portofolio" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-xl">
        <p class="text-sm font-bold uppercase tracking-widest text-electric-500">{p.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-cool-900 sm:text-4xl">
          {p.title}
        </h2>
      </div>
      <p class="text-sm text-cool-600">{p.note}</p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        gallery.map((g) => (
          <figure class="group overflow-hidden rounded-3xl border border-cool-100 shadow-sm">
            <div
              class="relative overflow-hidden cursor-pointer"
              role="button"
              tabindex={0}
              aria-label={`Buka gambar besar: ${g.label}`}
              data-lightbox-src={g.src}
              data-lightbox-alt={g.alt}
              data-lightbox-label={g.label}
              data-lightbox-group={groupKey(g.src)}
            >
              <img
                src={g.src}
                alt={g.alt}
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-electric-950/80 to-transparent px-5 pb-4 pt-10 text-sm font-bold text-white">
                {g.label}
              </figcaption>
              <span
                class="absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-cool-800 opacity-0 shadow-sm transition duration-300 group-hover:opacity-100"
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  class="h-4 w-4"
                >
                  <circle cx="11" cy="11" r="7" />
                  <line x1="16.5" y1="16.5" x2="21" y2="21" />
                  <line x1="11" y1="8" x2="11" y2="14" />
                  <line x1="8" y1="11" x2="14" y2="11" />
                </svg>
              </span>
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<!-- ====================== Popup Gambar Portofolio (Lightbox) ====================== -->
<div
  id="gallery-lightbox"
  class="fixed inset-0 z-[80] hidden items-center justify-center bg-cool-950/90 p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Tampilan besar gambar portofolio"
>
  <button
    id="gallery-lightbox-close"
    type="button"
    aria-label="Tutup gambar"
    class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-6 w-6"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>

  <!-- Navigasi: sebelumnya -->
  <button
    id="gallery-lightbox-prev"
    type="button"
    aria-label="Gambar sebelumnya"
    class="absolute left-3 top-1/2 -translate-y-1/2 z-10 hidden sm:flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white opacity-60 transition hover:bg-white/20 hover:opacity-100 sm:left-4"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M15 19l-7-7 7-7" /></svg>
  </button>

  <div class="flex max-h-full max-w-5xl items-center justify-center">
    <img
      id="gallery-lightbox-image"
      src=""
      alt=""
      class="max-h-[80vh] max-w-full rounded-2xl object-contain shadow-2xl"
    />
  </div>

  <!-- Navigasi: berikutnya -->
  <button
    id="gallery-lightbox-next"
    type="button"
    aria-label="Gambar berikutnya"
    class="absolute right-3 top-1/2 -translate-y-1/2 z-10 hidden sm:flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white opacity-60 transition hover:bg-white/20 hover:opacity-100 sm:right-4"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M9 5l7 7-7 7" /></svg>
  </button>

  <!-- Caption + penghitung -->
  <div class="absolute inset-x-0 bottom-6 flex items-center justify-between px-6">
    <p id="gallery-lightbox-caption" class="text-lg font-bold text-white"></p>
    <p id="gallery-lightbox-counter" class="text-sm font-medium text-white/70" aria-label="Penghitung gambar"></p>
  </div>
</div>

<script>
  // ---- Popup gambar (lightbox) pada seksi Portofolio ----
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('gallery-lightbox-image');
  const lightboxCaption = document.getElementById('gallery-lightbox-caption');
  const lightboxCounter = document.getElementById('gallery-lightbox-counter');
  const lightboxCloseBtn = document.getElementById('gallery-lightbox-close');
  const lightboxPrevBtn = document.getElementById('gallery-lightbox-prev');
  const lightboxNextBtn = document.getElementById('gallery-lightbox-next');

  // Semua item galeri dapat diklik.
  const items: HTMLElement[] = Array.from(
    document.querySelectorAll('[data-lightbox-src]')
  );

  // Kelompokkan item per kategori (data-lightbox-group) yang dihasilkan
  // dari awalan nama file, supaya navigasi hanya berlaku pada gambar
  // dengan kategori sama (mis. pemasagan_ac1..7).
  const groups = new Map<string, HTMLElement[]>();
  for (const el of items) {
    const group = el.getAttribute('data-lightbox-group') || '';
    if (!groups.has(group)) groups.set(group, []);
    groups.get(group)!.push(el);
  }

  let currentGroup: HTMLElement[] = [];
  let currentIndex = 0;

  function renderItem(index: number) {
    const el = currentGroup[index];
    if (!el || !lightboxImg) return;
    lightboxImg.src = el.getAttribute('data-lightbox-src') || '';
    lightboxImg.alt = el.getAttribute('data-lightbox-alt') || '';
    if (lightboxCaption) lightboxCaption.textContent = el.getAttribute('data-lightbox-label') || '';
    if (lightboxCounter) lightboxCounter.textContent = `${index + 1} / ${currentGroup.length}`;
    const hasNav = currentGroup.length > 1;
    if (lightboxPrevBtn) lightboxPrevBtn.classList.toggle('hidden', !hasNav);
    if (lightboxNextBtn) lightboxNextBtn.classList.toggle('hidden', !hasNav);
  }

  function openLightbox(el: HTMLElement) {
    if (!lightbox || !el) return;
    const group = el.getAttribute('data-lightbox-group') || '';
    currentGroup = groups.get(group) || [el];
    currentIndex = currentGroup.indexOf(el);
    if (currentIndex === -1) currentIndex = 0;
    renderItem(currentIndex);
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function showPrev() {
    if (!currentGroup.length) return;
    currentIndex = (currentIndex - 1 + currentGroup.length) % currentGroup.length;
    renderItem(currentIndex);
  }
  function showNext() {
    if (!currentGroup.length) return;
    currentIndex = (currentIndex + 1) % currentGroup.length;
    renderItem(currentIndex);
  }

  items.forEach((el) => {
    const open = () => openLightbox(el);
    el.addEventListener('click', open);
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        open();
      }
    });
  });

  lightboxCloseBtn?.addEventListener('click', closeLightbox);
  lightboxPrevBtn?.addEventListener('click', showPrev);
  lightboxNextBtn?.addEventListener('click', showNext);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    const closed = !lightbox || lightbox.classList.contains('hidden');
    if (e.key === 'Escape') {
      if (closed) return;
      closeLightbox();
    }
    if (closed) return;
    if (e.key === 'ArrowLeft') showPrev();
    if (e.key === 'ArrowRight') showNext();
  });
</script>