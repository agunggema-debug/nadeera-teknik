---
// Pencacah pengunjung (global) di footer.
//
// IMPLEMENTASI: berbasis localStorage per-perangkat — tanpa panggilan jaringan
// eksternal, sehingga tidak ada request yang gagal di konsol browser.
// - "Kunjungan hari ini" otomatis reset setiap tengah malam (berdasarkan tanggal).
// - Setiap perangkat hanya menambah +1 per hari.
//
// Catatan: angka "total" adalah jumlah per-perangkat, bukan jumlah pengunjung
// unik global. Bila ingin akurasi antar-perangkat, ganti dengan layanan pihak
// ketiga lain (mis. Supabase) — namun pastikan layanan itu dapat di-resolve.
---

<div class="flex flex-wrap items-center gap-x-8 gap-y-4 text-sm">
  <div class="flex items-center gap-3">
    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-electric-100">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
        <path d="M12 3a7 7 0 0 0-7 7c0 4.5 3 8 7 10 4-2 7-5.5 7-10a7 7 0 0 0-7-7z" />
        <circle cx="12" cy="10" r="2.2" />
      </svg>
    </span>
    <div>
      <p class="text-xs uppercase tracking-wide text-electric-100/60">Kunjungan hari ini</p>
      <p class="font-extrabold text-white"><span id="visit-today">···</span></p>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-electric-100">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
        <circle cx="9" cy="8" r="3" /><circle cx="17" cy="9.5" r="2.5" />
        <path d="M3 20c.8-3.2 3-5 6-5s5.2 1.8 6 5" />
        <path d="M16 15.5c2.6.4 4.4 2 5 4.5" />
      </svg>
    </span>
    <div>
      <p class="text-xs uppercase tracking-wide text-electric-100/60">Total pengunjung</p>
      <p class="font-extrabold text-white"><span id="visit-total">···</span></p>
    </div>
  </div>
</div>

<script>
  // Pencacah pengunjung mandiri via localStorage (tanpa jaringan eksternal).
  const now = new Date();

  // Kunci yang memuat tanggal "hari ini" agar hitungan harian direset otomatis.
  const ymd =
    now.getFullYear() +
    String(now.getMonth() + 1).padStart(2, '0') +
    String(now.getDate()).padStart(2, '0');

  const TOTAL_KEY = 'nt_total';
  const TODAY_KEY = 'nt_today';
  const TODAY_DATE_KEY = 'nt_today_date';
  // Tandai bahwa perangkat ini sudah dihitung hari ini.
  const COUNT_MARK = 'nt_counted_' + ymd;

  function readRaw(key: string): string | null {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }
  function writeInt(key: string, val: number) {
    try {
      localStorage.setItem(key, String(val));
    } catch {
      /* abaikan bila storage penuh/diblokir */
    }
  }
  function readCount(key: string): number {
    const v = Number(readRaw(key) || 0);
    return Number.isFinite(v) ? v : 0;
  }

  let total = readCount(TOTAL_KEY);
  let today = readCount(TODAY_KEY);

  // Jika tanggal sudah berganti (hari baru), reset hitungan hari ini.
  if (readRaw(TODAY_DATE_KEY) !== ymd) {
    today = 0;
    try {
      localStorage.setItem(TODAY_DATE_KEY, ymd);
    } catch {
      /* abaikan */
    }
  }

  // Tambahkan +1 sekali per perangkat per hari.
  if (readRaw(COUNT_MARK) === null) {
    total += 1;
    today += 1;
    writeInt(TOTAL_KEY, total);
    writeInt(TODAY_KEY, today);
    writeInt(COUNT_MARK, 1);
  }

  const totalEl = document.getElementById('visit-total') as HTMLElement | null;
  const todayEl = document.getElementById('visit-today') as HTMLElement | null;
  if (totalEl) totalEl.textContent = total.toLocaleString('id-ID');
  if (todayEl) todayEl.textContent = today.toLocaleString('id-ID');
</script>