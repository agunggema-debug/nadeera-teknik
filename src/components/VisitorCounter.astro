---
// Pencacah pengunjung (global) di footer.
//
// IMPLEMENTASI: berbasis Supabase — angka "Kunjungan hari ini" dan "Total
// pengunjung" tersimpan di tabel `visitor_stats` (lihat SETUP_SUPABASE.md),
// sehingga akurat lintas-perangkat, bukan sekadar per-perangkat.
// - Setiap perangkat hanya menambah +1 per hari (penanda di localStorage),
//   jadi reload berulang tidak menaikkan angka.
// - "Kunjungan hari ini" otomatis reset setiap tengah malam (waktu server).
// - Bila Supabase belum dikonfigurasi, fallback ke hitungan localStorage lama.
---

<div class="flex flex-wrap items-center gap-x-8 gap-y-4 text-sm">
  <div class="flex items-center gap-3">
    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-electric-100">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
        <path d="M12 3a7 7 0 0 0-7 7c0 4.5 3 8 7 10 4-2 7-5.5 7-10a7 7 0 0 0-7-7z" />
        <circle cx="12" cy="10" r="2.2" />
      </svg>
    </span>
    <div>
      <p class="text-xs uppercase tracking-wide text-electric-100/60">Kunjungan hari ini</p>
      <p class="font-extrabold text-white"><span id="visit-today">···</span></p>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 text-electric-100">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
        <circle cx="9" cy="8" r="3" /><circle cx="17" cy="9.5" r="2.5" />
        <path d="M3 20c.8-3.2 3-5 6-5s5.2 1.8 6 5" />
        <path d="M16 15.5c2.6.4 4.4 2 5 4.5" />
      </svg>
    </span>
    <div>
      <p class="text-xs uppercase tracking-wide text-electric-100/60">Total pengunjung</p>
      <p class="font-extrabold text-white"><span id="visit-total">···</span></p>
    </div>
  </div>
</div>

<script>
  import { isSupabaseConfigured, supabase } from '../lib/supabase';

  const now = new Date();
  // Tanggal "hari ini" (YYYYMMDD) untuk penanda dedup per perangkat.
  const ymd =
    now.getFullYear() +
    String(now.getMonth() + 1).padStart(2, '0') +
    String(now.getDate()).padStart(2, '0');

  // Penanda bahwa perangkat ini sudah dihitung hari ini (hindari +1 saat reload).
  const COUNT_MARK = 'nt_counted_' + ymd;

  // Kunci fallback (dipakai hanya bila Supabase belum dikonfigurasi).
  const TOTAL_KEY = 'nt_total';
  const TODAY_KEY = 'nt_today';
  const TODAY_DATE_KEY = 'nt_today_date';

  const totalEl = document.getElementById('visit-total') as HTMLElement | null;
  const todayEl = document.getElementById('visit-today') as HTMLElement | null;

  function show(total: number, today: number) {
    if (totalEl) totalEl.textContent = total.toLocaleString('id-ID');
    if (todayEl) todayEl.textContent = today.toLocaleString('id-ID');
  }

  function readRaw(key: string): string | null {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }
  function writeRaw(key: string, val: string) {
    try {
      localStorage.setItem(key, val);
    } catch {
      /* abaikan bila storage penuh/diblokir */
    }
  }
  function readCount(key: string): number {
    const v = Number(readRaw(key) || 0);
    return Number.isFinite(v) ? v : 0;
  }

  // Fallback bila Supabase belum dikonfigurasi: perilaku lama (localStorage).
  function localStorageFallback() {
    let total = readCount(TOTAL_KEY);
    let today = readCount(TODAY_KEY);

    // Hari berganti -> reset hitungan hari ini.
    if (readRaw(TODAY_DATE_KEY) !== ymd) {
      today = 0;
      writeRaw(TODAY_DATE_KEY, ymd);
    }

    // +1 sekali per perangkat per hari.
    if (readRaw(COUNT_MARK) === null) {
      total += 1;
      today += 1;
      writeRaw(TOTAL_KEY, String(total));
      writeRaw(TODAY_KEY, String(today));
      writeRaw(COUNT_MARK, '1');
    }
    show(total, today);
  }

  async function init() {
    if (!isSupabaseConfigured || !supabase) {
      localStorageFallback();
      return;
    }

    // Sudah dihitung hari ini? -> cukup baca, tanpa menambah angka global.
    const alreadyCounted = readRaw(COUNT_MARK) !== null;

    try {
      const { data, error } = await supabase.rpc('record_visit', {
        p_increment: !alreadyCounted,
      });
      if (error) throw error;
      if (data && typeof data.total === 'number' && typeof data.today === 'number') {
        show(data.total, data.today);
      }
      // Catat bahwa perangkat ini sudah dihitung (baru setelah RPC sukses).
      if (!alreadyCounted) writeRaw(COUNT_MARK, '1');
    } catch {
      // Jika koneksi/RPC gagal, tampilkan angka lokal sebagai cadangan.
      localStorageFallback();
    }
  }

  init();
</script>