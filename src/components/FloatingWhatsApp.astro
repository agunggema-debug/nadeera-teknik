---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { waLink } from '../site';
---

<a
  href={waLink('Halo Nadeera Teknik, saya butuh bantuan jasa AC.')}
  target="_blank"
  rel="noopener"
  aria-label="Chat WhatsApp dengan Nadeera Teknik"
  title="Chat WhatsApp"
  class="group fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-full bg-green-500 py-3 pl-4 pr-4 text-white shadow-xl shadow-green-600/30 transition hover:bg-green-600 sm:bottom-6 sm:right-6 sm:pr-5"
>
  <span class="relative flex h-6 w-6 items-center justify-center">
    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white/40 opacity-75" aria-hidden="true"></span>
    <WhatsAppIcon class="relative h-6 w-6" />
  </span>
  <span class="hidden text-sm font-bold sm:inline">WhatsApp Kami</span>
</a>