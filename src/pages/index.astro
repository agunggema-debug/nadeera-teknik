---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { getSiteContent } from '../lib/site-content';

// Konten diambil dari Supabase saat halaman diminta (SSR), dengan fallback
// ke konten default bila Supabase belum dikonfigurasi / tabel masih kosong.
const content = await getSiteContent();
---

<BaseLayout>
  <a
    href="#beranda"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:font-bold focus:text-electric-700 focus:shadow-lg"
  >
    Lewati ke konten utama
  </a>

  <Header content={content.navigation} />

  <main>
    <Hero content={content.hero} />
    <Services content={content.services} />
    <ServiceAreas content={content.areas} />
    <Pricing content={content.pricing} />
    <Testimonials content={content.testimonials} portfolio={content.portfolio} />
    <CtaBand content={content.cta} />
  </main>

  <Footer content={content.footer} />
  <FloatingWhatsApp />
</BaseLayout>