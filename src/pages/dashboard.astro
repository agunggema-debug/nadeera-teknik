---
import '../styles/global.css';
import { SITE } from '../site';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Dashboard Admin — {SITE.title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-cool-50 text-cool-900 antialiased">
    <!-- ============ Tampilan loading ============ -->
    <div id="dash-loading" class="flex min-h-screen items-center justify-center">
      <div class="text-center">
        <svg class="mx-auto h-10 w-10 animate-spin text-electric-600" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z" />
        </svg>
        <p class="mt-4 text-sm font-semibold text-cool-700">Memeriksa sesi…</p>
      </div>
    </div>

    <!-- ============ Supabase belum dikonfigurasi ============ -->
    <div id="dash-setup" class="hidden min-h-screen items-center justify-center p-6">
      <div class="w-full max-w-lg rounded-3xl border border-cool-100 bg-white p-8 shadow-lg">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-700">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
            <path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
          </svg>
        </span>
        <h1 class="mt-5 text-2xl font-extrabold tracking-tight">Supabase belum dikonfigurasi</h1>
        <p class="mt-2 text-sm leading-relaxed text-cool-600">
          Untuk mengaktifkan login staff dan dashboard pengelolaan konten, isi
          <code class="rounded bg-cool-100 px-1.5 py-0.5 font-mono text-xs">PUBLIC_SUPABASE_URL</code>
          dan
          <code class="rounded bg-cool-100 px-1.5 py-0.5 font-mono text-xs">PUBLIC_SUPABASE_ANON_KEY</code>
          pada file <code class="rounded bg-cool-100 px-1.5 py-0.5 font-mono text-xs">.env</code>,
          lalu jalankan kembali server. Baca panduan lengkap di file
          <code class="rounded bg-cool-100 px-1.5 py-0.5 font-mono text-xs">SETUP_SUPABASE.md</code>.
        </p>
        <a href="/" class="mt-6 inline-flex rounded-full bg-electric-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-electric-700">
          Kembali ke Beranda
        </a>
      </div>
    </div>

    <!-- ============ Form login Google ============ -->
    <div id="dash-login" class="hidden min-h-screen items-center justify-center p-4">
      <div class="w-full max-w-md rounded-3xl border border-cool-100 bg-white p-6 shadow-xl sm:p-8">
        <div class="flex items-center justify-between">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-electric-100 text-electric-700">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
              <rect x="4" y="11" width="16" height="10" rx="2" />
              <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            </svg>
          </span>
          <a href="/" class="rounded-lg p-1.5 text-cool-600 transition hover:bg-cool-100 hover:text-cool-900" aria-label="Kembali ke beranda">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </a>
        </div>

        <h1 class="mt-5 text-2xl font-extrabold tracking-tight">Login Staf</h1>
        <p class="mt-1.5 text-sm text-cool-600">Masuk untuk mengelola konten website Nadeera Teknik.</p>

        <button
          id="dash-google-btn"
          type="button"
          class="mt-6 flex w-full items-center justify-center gap-3 rounded-2xl border border-cool-200 bg-white px-5 py-3.5 text-base font-semibold text-cool-900 shadow-sm transition hover:border-cool-300 hover:bg-cool-50 active:scale-[0.99]"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
            <path fill="#4285F4" d="M23.5 12.27c0-.85-.08-1.66-.22-2.45H12v4.64h6.45a5.52 5.52 0 0 1-2.4 3.62v3h3.88c2.27-2.09 3.57-5.17 3.57-8.81z" />
            <path fill="#34A853" d="M12 24c3.24 0 5.96-1.08 7.94-2.91l-3.88-3c-1.08.72-2.45 1.15-4.06 1.15-3.12 0-5.77-2.11-6.71-4.94H1.27v3.1A12 12 0 0 0 12 24z" />
            <path fill="#FBBC05" d="M5.29 14.3a7.2 7.2 0 0 1 0-4.6v-3.1H1.27a12 12 0 0 0 0 10.8l4.02-3.1z" />
            <path fill="#EA4335" d="M12 4.76c1.76 0 3.34.6 4.58 1.79l3.44-3.44A11.97 11.97 0 0 0 1.27 6.6l4.02 3.1C6.23 6.87 8.88 4.76 12 4.76z" />
          </svg>
          Sign in with Google
        </button>

        <!-- Kalimat khusus staff -->
        <p class="mt-4 text-center text-xs text-cool-600">
          khusus untuk staff <span class="font-bold text-electric-700">nadeera teknik</span>
        </p>
        <p id="dash-login-error" class="mt-4 hidden rounded-xl bg-red-50 px-4 py-3 text-center text-sm font-semibold text-red-700"></p>
      </div>
    </div>

    <!-- ============ Tidak punya akses ============ -->
    <div id="dash-denied" class="hidden min-h-screen items-center justify-center p-4">
      <div class="w-full max-w-md rounded-3xl border border-cool-100 bg-white p-8 text-center shadow-lg">
        <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-red-100 text-red-700">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
            <rect x="4" y="11" width="16" height="10" rx="2" />
            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
          </svg>
        </span>
        <h1 class="mt-5 text-2xl font-extrabold tracking-tight">Akses Ditolak</h1>
        <p class="mt-2 text-sm leading-relaxed text-cool-600">
          Akun Google Anda tidak terdaftar sebagai admin dan tidak memiliki akses
          ke dashboard ini. Anda akan dialihkan kembali ke halaman website.
        </p>
        <a
          href="/"
          class="mt-6 inline-flex rounded-full bg-electric-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-electric-700"
        >
          Kembali ke Beranda
        </a>
      </div>
    </div>


    <!-- ============ Dashboard editor ============ -->
    <div id="dash-editor" class="hidden bg-cool-50">
      <!-- Overlay (mobile) -->
      <div id="sb-overlay" class="fixed inset-0 z-40 hidden bg-cool-900/40 backdrop-blur-sm lg:hidden"></div>

      <!-- SIDEBAR -->
      <aside
        id="dash-sidebar"
        class="fixed inset-y-0 left-0 z-50 flex w-72 flex-col bg-gradient-to-b from-electric-950 via-electric-900 to-electric-950 text-cool-100 shadow-2xl -translate-x-full transition-transform duration-300 lg:translate-x-0"
      >
        <!-- Logo brand -->
        <div class="flex items-center gap-3 px-5 py-5">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-electric-400 to-accent-500 text-white shadow-lg shadow-black/20">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
              <path d="M12 2v1.5m0 17V22M4.2 4.2l1.1 1.1m13.4 13.4 1.1 1.1M2 12h1.5m17 0H22M4.2 19.8l1.1-1.1m13.4-13.4 1.1-1.1" opacity=".4" />
              <path d="M8.5 12h7M12 8.5v7" />
            </svg>
          </span>
          <div class="min-w-0">
            <p class="text-lg font-extrabold leading-tight tracking-tight text-white">Nadeera Teknik</p>
            <p class="text-[11px] font-semibold uppercase tracking-widest text-electric-300">Dashboard Konten</p>
          </div>
        </div>

        <!-- Menu -->
        <div class="mt-2 flex-1 overflow-y-auto px-3 pb-4">
          <p class="px-3 pb-2 text-[10px] font-bold uppercase tracking-widest text-electric-300">Menu Konten</p>
          <div id="dash-nav" class="space-y-1"></div>
        </div>

          <!-- Profil + keluar -->
        <div class="border-t border-white/10 p-4">
          <div class="flex items-center gap-3 rounded-2xl bg-white/5 p-3">
            <span id="dash-avatar-side" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-accent-400 to-accent-600 text-sm font-extrabold text-white shadow"></span>
            <div class="min-w-0 flex-1">
              <p id="dash-user-side" class="truncate text-sm font-semibold text-white"></p>
              <p class="text-[11px] font-medium text-electric-300">Administrator</p>
            </div>
          </div>
          <button
            id="dash-logout-side"
            type="button"
            class="group mt-3 flex w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-semibold text-cool-100 transition hover:border-red-400/40 hover:bg-red-500/20 hover:text-white"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
            Keluar
          </button>
        </div>
      </aside>

      <!-- KONTEN UTAMA -->
      <div class="min-h-screen lg:pl-72">
        <!-- Topbar -->
        <header class="sticky top-0 z-30 border-b border-cool-100 bg-white/85 backdrop-blur-md">
          <div class="flex h-16 items-center justify-between gap-3 px-4 sm:px-6">
            <div class="flex items-center gap-3">
              <button id="sb-toggle" type="button" class="flex h-10 w-10 items-center justify-center rounded-xl border border-cool-100 text-cool-700 transition hover:bg-cool-50 lg:hidden" aria-label="Buka menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
              </button>
              <a href="/" class="flex h-10 w-10 items-center justify-center rounded-xl border border-cool-100 text-cool-700 transition hover:bg-cool-50" aria-label="Lihat website">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
              </a>
              <div>
                <h1 class="text-base font-extrabold leading-tight tracking-tight text-cool-900">Kelola Konten Website</h1>
                <p class="text-xs font-medium text-cool-600">Edit & simpan konten setiap bagian</p>
              </div>
            </div>

            <!-- Profil dropdown -->
            <div class="relative">
              <button id="dash-user-toggle" type="button" class="flex items-center gap-2.5 rounded-full border border-cool-100 bg-white py-1 pl-1 pr-3 shadow-sm transition hover:bg-cool-50">
                <span id="dash-avatar" class="flex h-8 w-8 items-center justify-center rounded-full bg-electric-600 text-xs font-extrabold text-white"></span>
                <span class="hidden text-sm font-semibold text-cool-700 sm:block">Profil</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-cool-600"><path d="M6 9l6 6 6-6" /></svg>
              </button>
              <div id="dash-profile-menu" class="absolute right-0 mt-2 hidden w-60 overflow-hidden rounded-2xl border border-cool-100 bg-white shadow-xl">
                <div class="border-b border-cool-100 bg-cool-50 px-4 py-3">
                  <p id="dash-user-label" class="truncate text-sm font-bold text-cool-900"></p>
                  <p class="text-xs text-cool-600">Login Google</p>
                </div>
                <div class="px-2 py-1.5">
                  <a href="/" class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-medium text-cool-600 transition hover:bg-cool-50 hover:text-electric-600">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
                    Lihat Website
                  </a>
                </div>
                <div class="border-t border-cool-100 p-2">
                  <button id="dash-logout" type="button" class="flex w-full items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-semibold text-red-600 transition hover:bg-red-50">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
                    Keluar
                  </button>
                </div>
              </div>
            </div>
          </div>
        </header>

        <!-- Main -->
        <main class="mx-auto max-w-6xl px-4 py-6 pb-20 sm:px-6 lg:py-8">
          <!-- Statistik ringkas -->
          <div id="dash-stats" class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4"></div>
        <!-- Petunjuk -->
          <div class="mt-6 flex items-start gap-3 rounded-2xl border border-electric-100 bg-gradient-to-r from-electric-50 to-accent-50 px-5 py-4 text-sm leading-relaxed text-electric-900 shadow-sm">
            <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-electric-600 text-white shadow-sm">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4.5 w-4.5" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 16v-4M12 8h.01" />
              </svg>
            </span>
            <p>
              <strong class="font-bold">Petunjuk:</strong> Edit konten pada setiap bagian lalu klik
              <strong class="font-bold">Simpan</strong>. Perubahan langsung tampil di website publik.
              Untuk daftar item (mis. layanan, harga, testimoni), gunakan tombol
              <em class="not-italic font-semibold">Tambah</em> / <em class="not-italic font-semibold">Hapus</em>.
            </p>
          </div>

          <!-- Daftar seksi -->
          <div id="dash-sections" class="mt-6 space-y-5"></div>

          <div id="dash-toast" class="pointer-events-none fixed bottom-6 left-1/2 z-[60] -translate-x-1/2 rounded-full bg-cool-900 px-5 py-2.5 text-sm font-semibold text-white opacity-0 shadow-lg transition-opacity"></div>
        </main>
      </div>
    </div>


    <script>
      import { isSupabaseConfigured, supabase, authRedirectTo, describeAuthError } from '../lib/supabase';
      import { DEFAULT_CONTENT } from '../lib/default-content';
      import { mergeContent } from '../lib/site-content';

      const $ = (id: string) => document.getElementById(id);

      // ---------- Helper DOM ----------
      const inputCls =
        'w-full rounded-xl border border-cool-200 bg-white px-3.5 py-2.5 text-sm text-cool-900 placeholder:text-cool-400 focus:border-electric-400 focus:outline-none focus:ring-2 focus:ring-electric-200';

      function el<K extends keyof HTMLElementTagNameMap>(
        tag: K,
        attrs: Record<string, string> = {},
        children: Node[] = []
      ): HTMLElementTagNameMap[K] {
        const node = document.createElement(tag);
        for (const [k, v] of Object.entries(attrs)) {
          if (k === 'className') node.className = v;
          else node.setAttribute(k, v);
        }
        for (const c of children) node.appendChild(c);
        return node;
      }

      function fieldLabel(text: string) {
        return el('span', { className: 'text-xs font-bold uppercase tracking-wider text-cool-600' }, [document.createTextNode(text)]);
      }

      function fieldWrap(label: string, control: HTMLElement, hint?: string) {
        const wrap = el('div', { className: 'flex flex-col gap-1.5' });
        wrap.appendChild(fieldLabel(label));
        wrap.appendChild(control);
        if (hint) wrap.appendChild(el('p', { className: 'text-xs text-cool-500' }, [document.createTextNode(hint)]));
        return wrap;
      }

      function textInput(value: unknown): HTMLInputElement {
        const inp = el('input', { type: 'text', className: inputCls });
        inp.value = value == null ? '' : String(value);
        return inp;
      }
      function textArea(value: unknown): HTMLTextAreaElement {
        const inp = el('textarea', { rows: '3', className: inputCls });
        inp.value = value == null ? '' : String(value);
        return inp;
      }
      function numInput(value: unknown): HTMLInputElement {
        const inp = el('input', { type: 'number', className: inputCls });
        inp.value = value == null ? '' : String(value);
        return inp;
      }
      function delBtn() {
        const b = el('button', { type: 'button', className: 'inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-red-200 text-red-600 transition hover:bg-red-50' });
        b.textContent = '✕';
        return b;
      }
      function addBtn(text: string) {
        const b = el('button', { type: 'button', className: 'inline-flex items-center gap-1 rounded-full border border-electric-200 bg-white px-4 py-2 text-sm font-semibold text-electric-700 transition hover:bg-electric-50' });
        b.textContent = '+ ' + text;
        return b;
      }

      // ---------- Toast ----------
      let toastTimer: number | undefined;
      function toast(msg: string, ok = true) {
        const t = $('dash-toast');
        if (!t) return;
        t.textContent = msg;
        t.style.background = ok ? 'rgb(11 35 84)' : 'rgb(190 18 60)';
        t.style.opacity = '1';
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => (t.style.opacity = '0'), 2600);
      }


      // ---------- Render form generik ----------
      function ensureArr(v: unknown): unknown[] {
        return Array.isArray(v) ? (v as unknown[]) : [];
      }

      function renderFields(root: HTMLElement, obj: Record<string, unknown>, fields: any[]) {
        for (const f of fields) {
          if (f.type === 'text' || f.type === 'textarea' || f.type === 'number') {
            const inp =
              f.type === 'textarea' ? textArea(obj[f.k]) : f.type === 'number' ? numInput(obj[f.k]) : textInput(obj[f.k]);
            inp.addEventListener('input', () => {
              obj[f.k] = f.type === 'number' ? Number(inp.value) : inp.value;
            });
            root.appendChild(fieldWrap(f.label, inp, f.hint));
          } else if (f.type === 'stringArr') {
            const arr = ensureArr(obj[f.k]);
            obj[f.k] = arr;
            const box = el('div', { className: 'space-y-2' });
            const renderList = () => {
              box.replaceChildren();
              arr.forEach((val, i) => {
                const row = el('div', { className: 'flex gap-2' });
                const inp = textInput(val);
                inp.addEventListener('input', () => (arr[i] = inp.value));
                const d = delBtn();
                d.addEventListener('click', () => {
                  arr.splice(i, 1);
                  renderList();
                });
                row.append(inp, d);
                box.appendChild(row);
              });
              const a = addBtn(f.addLabel || 'Tambah');
              a.addEventListener('click', () => {
                arr.push('');
                renderList();
              });
              box.appendChild(el('div', {}, [a]));
            };
            renderList();
            root.appendChild(fieldWrap(f.label, box, f.hint));
          } else if (f.type === 'objArr') {
            const arr = ensureArr(obj[f.k]);
            obj[f.k] = arr;
            const box = el('div', { className: 'space-y-3' });
            const renderList = () => {
              box.replaceChildren();
              arr.forEach((item: Record<string, unknown>, idx: number) => {
                const card = el('div', { className: 'rounded-xl border border-cool-100 bg-cool-50/60 p-4' });
                const head = el('div', { className: 'mb-3 flex items-center justify-between gap-2' });
                head.appendChild(
                  el('span', { className: 'text-sm font-bold text-cool-900' }, [
                    document.createTextNode(f.itemLabel ? f.itemLabel(item, idx) : 'Item ' + (idx + 1)),
                  ])
                );
                const d = delBtn();
                d.addEventListener('click', () => {
                  arr.splice(idx, 1);
                  renderList();
                });
                head.appendChild(d);
                card.appendChild(head);
                const fieldsBox = el('div', { className: 'space-y-3' });
                renderFields(fieldsBox, item, f.fields);
                card.appendChild(fieldsBox);
                box.appendChild(card);
              });
              const a = addBtn(f.addLabel || 'Tambah item');
              a.addEventListener('click', () => {
                const newItem: Record<string, unknown> = {};
                for (const fx of f.fields) {
                  newItem[fx.k] = fx.type === 'number' ? 0 : fx.type === 'objArr' || fx.type === 'stringArr' ? [] : '';
                }
                arr.push(newItem);
                renderList();
              });
              box.appendChild(el('div', {}, [a]));
            };
            renderList();
            const wrap = el('div', { className: 'flex flex-col gap-1.5' });
            wrap.appendChild(fieldLabel(f.label));
            wrap.appendChild(box);
            if (f.hint) wrap.appendChild(el('p', { className: 'text-xs text-cool-500' }, [document.createTextNode(f.hint)]));
            root.appendChild(wrap);
          }
        }
      }

      // ---------- Skema seksi (dari hero → footer) ----------
      const SECTIONS: any[] = [
        {
          key: 'navigation',
          title: 'Navigasi',
          desc: 'Menu pada header situs.',
          fields: [
            {
              k: 'links', label: 'Menu Navigasi', type: 'objArr', addLabel: 'Tambah menu', itemLabel: (it: any) => it?.label || '',
              fields: [
                { k: 'label', label: 'Label', type: 'text' },
                { k: 'href', label: 'Tautan (href)', type: 'text', hint: 'Contoh: #layanan' },
              ],
            },
          ],
        },
        {
          key: 'hero',
          title: 'Hero (Banner Utama)',
          desc: 'Bagian paling atas halaman.',
          fields: [
            { k: 'eyebrow', label: 'Badge Atas', type: 'text' },
            { k: 'titleStart', label: 'Judul (awal)', type: 'text' },
            { k: 'titleHighlight', label: 'Kata yang Disorot', type: 'stringArr', addLabel: 'Tambah kata' },
            { k: 'titleEnd', label: 'Judul (akhir)', type: 'text' },
