---
import '../styles/global.css';
import { SITE } from '../site';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Dashboard Admin — {SITE.title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-cool-50 text-cool-900 antialiased">
    <!-- ============ Tampilan loading ============ -->
    <div id="dash-loading" class="flex min-h-screen items-center justify-center">
      <div class="text-center">
        <svg class="mx-auto h-10 w-10 animate-spin text-electric-600" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z" />
        </svg>
        <p class="mt-4 text-sm font-semibold text-cool-700">Memeriksa sesi…</p>
      </div>
    </div>

    <!-- ============ Supabase belum dikonfigurasi ============ -->
    <div id="dash-setup" class="hidden min-h-screen items-center justify-center p-6">
      <div class="w-full max-w-lg rounded-3xl border border-cool-100 bg-white p-8 shadow-lg">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-700">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
            <path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
          </svg>
        </span>
        <h1 class="mt-5 text-2xl font-extrabold tracking-tight">Supabase belum dikonfigurasi</h1>
        <p class="mt-2 text-sm leading-relaxed text-cool-600">
          Untuk mengaktifkan login staff dan dashboard pengelolaan konten, isi
          <code class="rounded bg-cool-100 px-1.5 py-0.5 font-mono text-xs">PUBLIC_SUPABASE_URL</code>
          dan
          <code class="rounded bg-cool-100 px-1.5 py-0.5 font-mono text-xs">PUBLIC_SUPABASE_ANON_KEY</code>
          pada file <code class="rounded bg-cool-100 px-1.5 py-0.5 font-mono text-xs">.env</code>,
          lalu jalankan kembali server. Baca panduan lengkap di file
          <code class="rounded bg-cool-100 px-1.5 py-0.5 font-mono text-xs">SETUP_SUPABASE.md</code>.
        </p>
        <a href="/" class="mt-6 inline-flex rounded-full bg-electric-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-electric-700">
          Kembali ke Beranda
        </a>
      </div>
    </div>

    <!-- ============ Form login Google ============ -->
    <div id="dash-login" class="hidden min-h-screen items-center justify-center p-4">
      <div class="w-full max-w-md rounded-3xl border border-cool-100 bg-white p-6 shadow-xl sm:p-8">
        <div class="flex items-center justify-between">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-electric-100 text-electric-700">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
              <rect x="4" y="11" width="16" height="10" rx="2" />
              <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            </svg>
          </span>
          <a href="/" class="rounded-lg p-1.5 text-cool-600 transition hover:bg-cool-100 hover:text-cool-900" aria-label="Kembali ke beranda">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </a>
        </div>

        <h1 class="mt-5 text-2xl font-extrabold tracking-tight">Login Staf</h1>
        <p class="mt-1.5 text-sm text-cool-600">Masuk untuk mengelola konten website Nadeera Teknik.</p>

        <button
          id="dash-google-btn"
          type="button"
          class="mt-6 flex w-full items-center justify-center gap-3 rounded-2xl border border-cool-200 bg-white px-5 py-3.5 text-base font-semibold text-cool-900 shadow-sm transition hover:border-cool-300 hover:bg-cool-50 active:scale-[0.99]"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
            <path fill="#4285F4" d="M23.5 12.27c0-.85-.08-1.66-.22-2.45H12v4.64h6.45a5.52 5.52 0 0 1-2.4 3.62v3h3.88c2.27-2.09 3.57-5.17 3.57-8.81z" />
            <path fill="#34A853" d="M12 24c3.24 0 5.96-1.08 7.94-2.91l-3.88-3c-1.08.72-2.45 1.15-4.06 1.15-3.12 0-5.77-2.11-6.71-4.94H1.27v3.1A12 12 0 0 0 12 24z" />
            <path fill="#FBBC05" d="M5.29 14.3a7.2 7.2 0 0 1 0-4.6v-3.1H1.27a12 12 0 0 0 0 10.8l4.02-3.1z" />
            <path fill="#EA4335" d="M12 4.76c1.76 0 3.34.6 4.58 1.79l3.44-3.44A11.97 11.97 0 0 0 1.27 6.6l4.02 3.1C6.23 6.87 8.88 4.76 12 4.76z" />
          </svg>
          Sign in with Google
        </button>

        <!-- Kalimat khusus staff -->
        <p class="mt-4 text-center text-xs text-cool-600">
          khusus untuk staff <span class="font-bold text-electric-700">nadeera teknik</span>
        </p>
        <p id="dash-login-error" class="mt-4 hidden rounded-xl bg-red-50 px-4 py-3 text-center text-sm font-semibold text-red-700"></p>
      </div>
    </div>

    <!-- ============ Tidak punya akses ============ -->
    <div id="dash-denied" class="hidden min-h-screen items-center justify-center p-4">
      <div class="w-full max-w-md rounded-3xl border border-cool-100 bg-white p-8 text-center shadow-lg">
        <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-red-100 text-red-700">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
            <rect x="4" y="11" width="16" height="10" rx="2" />
            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
          </svg>
        </span>
        <h1 class="mt-5 text-2xl font-extrabold tracking-tight">Akses Ditolak</h1>
        <p class="mt-2 text-sm leading-relaxed text-cool-600">
          Akun Google Anda tidak terdaftar sebagai admin dan tidak memiliki akses
          ke dashboard ini. Anda akan dialihkan kembali ke halaman website.
        </p>
        <a
          href="/"
          class="mt-6 inline-flex rounded-full bg-electric-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-electric-700"
        >
          Kembali ke Beranda
        </a>
      </div>
    </div>


    <!-- ============ Dashboard editor ============ -->
    <div id="dash-editor" class="hidden">
      <!-- Bar atas -->
      <header class="sticky top-0 z-30 border-b border-cool-100 bg-white/85 backdrop-blur-md">
        <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
          <div class="flex items-center gap-3">
            <a href="/" class="flex h-10 w-10 items-center justify-center rounded-xl border border-cool-100 text-cool-700 transition hover:bg-cool-50" aria-label="Lihat website">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
            </a>
            <div>
              <h1 class="text-base font-extrabold leading-none tracking-tight">Dashboard Konten</h1>
              <p id="dash-user" class="mt-1 text-xs text-cool-600">…</p>
            </div>
          </div>
          <button id="dash-logout" type="button" class="rounded-full border border-cool-200 px-4 py-2 text-sm font-semibold text-cool-700 transition hover:bg-cool-50">
            Keluar
          </button>
        </div>
      </header>

      <main class="mx-auto max-w-4xl px-4 py-8 sm:px-6">
        <div class="rounded-2xl border border-electric-100 bg-electric-50 px-5 py-4 text-sm text-electric-900">
          <strong class="font-bold">Petunjuk:</strong> Edit konten setiap seksi lalu klik
          <strong class="font-bold">Simpan</strong>. Perubahan langsung tampil di website publik.
          Untuk daftar item (mis. layanan, harga, testimoni), gunakan tombol
          <em>Tambah</em> / <em>Hapus</em>.
        </div>

        <!-- Daftar seksi -->
        <div id="dash-sections" class="mt-6 space-y-6"></div>

        <div id="dash-toast" class="pointer-events-none fixed bottom-6 left-1/2 z-40 -translate-x-1/2 rounded-full bg-cool-900 px-5 py-2.5 text-sm font-semibold text-white opacity-0 shadow-lg transition-opacity"></div>
      </main>
    </div>


    <script>
      import { isSupabaseConfigured, supabase, authRedirectTo, describeAuthError } from '../lib/supabase';
      import { DEFAULT_CONTENT } from '../lib/default-content';
      import { mergeContent } from '../lib/site-content';

      const $ = (id: string) => document.getElementById(id);

      // ---------- Helper DOM ----------
      const inputCls =
        'w-full rounded-xl border border-cool-200 bg-white px-3.5 py-2.5 text-sm text-cool-900 placeholder:text-cool-400 focus:border-electric-400 focus:outline-none focus:ring-2 focus:ring-electric-200';

      function el<K extends keyof HTMLElementTagNameMap>(
        tag: K,
        attrs: Record<string, string> = {},
        children: Node[] = []
      ): HTMLElementTagNameMap[K] {
        const node = document.createElement(tag);
        for (const [k, v] of Object.entries(attrs)) {
          if (k === 'className') node.className = v;
          else node.setAttribute(k, v);
        }
        for (const c of children) node.appendChild(c);
        return node;
      }

      function fieldLabel(text: string) {
        return el('span', { className: 'text-xs font-bold uppercase tracking-wider text-cool-600' }, [document.createTextNode(text)]);
      }

      function fieldWrap(label: string, control: HTMLElement, hint?: string) {
        const wrap = el('div', { className: 'flex flex-col gap-1.5' });
        wrap.appendChild(fieldLabel(label));
        wrap.appendChild(control);
        if (hint) wrap.appendChild(el('p', { className: 'text-xs text-cool-500' }, [document.createTextNode(hint)]));
        return wrap;
      }

      function textInput(value: unknown): HTMLInputElement {
        const inp = el('input', { type: 'text', className: inputCls });
        inp.value = value == null ? '' : String(value);
        return inp;
      }
      function textArea(value: unknown): HTMLTextAreaElement {
        const inp = el('textarea', { rows: '3', className: inputCls });
        inp.value = value == null ? '' : String(value);
        return inp;
      }
      function numInput(value: unknown): HTMLInputElement {
        const inp = el('input', { type: 'number', className: inputCls });
        inp.value = value == null ? '' : String(value);
        return inp;
      }
      function delBtn() {
        const b = el('button', { type: 'button', className: 'inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-red-200 text-red-600 transition hover:bg-red-50' });
        b.textContent = '✕';
        return b;
      }
      function addBtn(text: string) {
        const b = el('button', { type: 'button', className: 'inline-flex items-center gap-1 rounded-full border border-electric-200 bg-white px-4 py-2 text-sm font-semibold text-electric-700 transition hover:bg-electric-50' });
        b.textContent = '+ ' + text;
        return b;
      }

      // ---------- Toast ----------
      let toastTimer: number | undefined;
      function toast(msg: string, ok = true) {
        const t = $('dash-toast');
        if (!t) return;
        t.textContent = msg;
        t.style.background = ok ? 'rgb(11 35 84)' : 'rgb(190 18 60)';
        t.style.opacity = '1';
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => (t.style.opacity = '0'), 2600);
      }


      // ---------- Render form generik ----------
      function ensureArr(v: unknown): unknown[] {
        return Array.isArray(v) ? (v as unknown[]) : [];
      }

      function renderFields(root: HTMLElement, obj: Record<string, unknown>, fields: any[]) {
        for (const f of fields) {
          if (f.type === 'text' || f.type === 'textarea' || f.type === 'number') {
            const inp =
              f.type === 'textarea' ? textArea(obj[f.k]) : f.type === 'number' ? numInput(obj[f.k]) : textInput(obj[f.k]);
            inp.addEventListener('input', () => {
              obj[f.k] = f.type === 'number' ? Number(inp.value) : inp.value;
            });
            root.appendChild(fieldWrap(f.label, inp, f.hint));
          } else if (f.type === 'stringArr') {
            const arr = ensureArr(obj[f.k]);
            obj[f.k] = arr;
            const box = el('div', { className: 'space-y-2' });
            const renderList = () => {
              box.replaceChildren();
              arr.forEach((val, i) => {
                const row = el('div', { className: 'flex gap-2' });
                const inp = textInput(val);
                inp.addEventListener('input', () => (arr[i] = inp.value));
                const d = delBtn();
                d.addEventListener('click', () => {
                  arr.splice(i, 1);
                  renderList();
                });
                row.append(inp, d);
                box.appendChild(row);
              });
              const a = addBtn(f.addLabel || 'Tambah');
              a.addEventListener('click', () => {
                arr.push('');
                renderList();
              });
              box.appendChild(el('div', {}, [a]));
            };
            renderList();
            root.appendChild(fieldWrap(f.label, box, f.hint));
          } else if (f.type === 'objArr') {
            const arr = ensureArr(obj[f.k]);
            obj[f.k] = arr;
            const box = el('div', { className: 'space-y-3' });
            const renderList = () => {
              box.replaceChildren();
              arr.forEach((item: Record<string, unknown>, idx: number) => {
                const card = el('div', { className: 'rounded-xl border border-cool-100 bg-cool-50/60 p-4' });
                const head = el('div', { className: 'mb-3 flex items-center justify-between gap-2' });
                head.appendChild(
                  el('span', { className: 'text-sm font-bold text-cool-900' }, [
                    document.createTextNode(f.itemLabel ? f.itemLabel(item, idx) : 'Item ' + (idx + 1)),
                  ])
                );
                const d = delBtn();
                d.addEventListener('click', () => {
                  arr.splice(idx, 1);
                  renderList();
                });
                head.appendChild(d);
                card.appendChild(head);
                const fieldsBox = el('div', { className: 'space-y-3' });
                renderFields(fieldsBox, item, f.fields);
                card.appendChild(fieldsBox);
                box.appendChild(card);
              });
              const a = addBtn(f.addLabel || 'Tambah item');
              a.addEventListener('click', () => {
                const newItem: Record<string, unknown> = {};
                for (const fx of f.fields) {
                  newItem[fx.k] = fx.type === 'number' ? 0 : fx.type === 'objArr' || fx.type === 'stringArr' ? [] : '';
                }
                arr.push(newItem);
                renderList();
              });
              box.appendChild(el('div', {}, [a]));
            };
            renderList();
            const wrap = el('div', { className: 'flex flex-col gap-1.5' });
            wrap.appendChild(fieldLabel(f.label));
            wrap.appendChild(box);
            if (f.hint) wrap.appendChild(el('p', { className: 'text-xs text-cool-500' }, [document.createTextNode(f.hint)]));
            root.appendChild(wrap);
          }
        }
      }

      // ---------- Skema seksi (dari hero → footer) ----------
      const SECTIONS: any[] = [
        {
          key: 'navigation',
          title: 'Navigasi',
          desc: 'Menu pada header situs.',
          fields: [
            {
              k: 'links', label: 'Menu Navigasi', type: 'objArr', addLabel: 'Tambah menu', itemLabel: (it: any) => it?.label || '',
              fields: [
                { k: 'label', label: 'Label', type: 'text' },
                { k: 'href', label: 'Tautan (href)', type: 'text', hint: 'Contoh: #layanan' },
              ],
            },
          ],
        },
        {
          key: 'hero',
          title: 'Hero (Banner Utama)',
          desc: 'Bagian paling atas halaman.',
          fields: [
            { k: 'eyebrow', label: 'Badge Atas', type: 'text' },
            { k: 'titleStart', label: 'Judul (awal)', type: 'text' },
            { k: 'titleHighlight', label: 'Kata yang Disorot', type: 'stringArr', addLabel: 'Tambah kata' },
            { k: 'titleEnd', label: 'Judul (akhir)', type: 'text' },
            { k: 'subtitle', label: 'Sub-judul', type: 'textarea' },
            { k: 'ctaPrimary', label: 'Tombol Utama', type: 'text' },
            { k: 'ctaSecondary', label: 'Tombol Sekunder', type: 'text' },
            { k: 'tempLabel', label: 'Suhu Contoh', type: 'text' },
            { k: 'tempCaption', label: 'Keterangan Suhu', type: 'text' },
            {
              k: 'trust', label: 'Poin Kepercayaan', type: 'objArr', addLabel: 'Tambah poin', itemLabel: (it: any) => it?.title || '',
              fields: [
                { k: 'title', label: 'Judul', type: 'text' },
                { k: 'desc', label: 'Deskripsi', type: 'text' },
              ],
            },
          ],
        },
        {
          key: 'services',
          title: 'Layanan',
          desc: 'Grid layanan jasa yang ditawarkan.',
          fields: [
            { k: 'eyebrow', label: 'Label Atas', type: 'text' },
            { k: 'title', label: 'Judul', type: 'text' },
            { k: 'subtitle', label: 'Sub-judul', type: 'textarea' },
            { k: 'pricePrefix', label: 'Teks Harga (awal)', type: 'text' },
            { k: 'ctaLabel', label: 'Label Tombol CTA', type: 'text' },
            {
              k: 'items', label: 'Daftar Layanan', type: 'objArr', addLabel: 'Tambah layanan', itemLabel: (it: any) => it?.short || it?.title || '',
              fields: [
                { k: 'id', label: 'ID (slug)', type: 'text' },
                { k: 'title', label: 'Nama Layanan', type: 'text' },
                { k: 'short', label: 'Nama Singkat', type: 'text' },
                { k: 'desc', label: 'Deskripsi', type: 'textarea' },
                { k: 'priceStart', label: 'Harga Mulai (Rp)', type: 'number' },
                { k: 'image', label: 'Path Gambar', type: 'text', hint: 'Contoh: /images/icon-cuci.svg' },
              ],
            },
          ],
        },
        {
          key: 'areas',
          title: 'Area Layanan',
          desc: 'Cakupan wilayah yang dilayani.',
          fields: [
            { k: 'eyebrow', label: 'Label Atas', type: 'text' },
            { k: 'title', label: 'Judul', type: 'text' },
            { k: 'subtitle', label: 'Sub-judul', type: 'textarea' },
            { k: 'ctaNote', label: 'Teks Sebelum Tautan', type: 'text' },
            { k: 'ctaLink', label: 'Teks Tautan', type: 'text' },
            { k: 'items', label: 'Daftar Area', type: 'stringArr', addLabel: 'Tambah area' },
          ],
        },
        {
          key: 'pricing',
          title: 'Harga',
          desc: 'Tabel estimasi harga dasar.',
          fields: [
            { k: 'eyebrow', label: 'Label Atas', type: 'text' },
            { k: 'title', label: 'Judul', type: 'text' },
            { k: 'subtitle', label: 'Sub-judul', type: 'textarea' },
            { k: 'headerLayanan', label: 'Kolom: Layanan', type: 'text' },
            { k: 'headerSatuan', label: 'Kolom: Satuan', type: 'text' },
            { k: 'headerEstimasi', label: 'Kolom: Estimasi', type: 'text' },
            { k: 'headerCatatan', label: 'Kolom: Catatan', type: 'text' },
            { k: 'footnote', label: 'Catatan Kaki', type: 'textarea' },
            { k: 'cta', label: 'Teks Tombol CTA', type: 'text' },
            {
              k: 'rows', label: 'Baris Harga', type: 'objArr', addLabel: 'Tambah baris', itemLabel: (it: any) => it?.service || '',
              fields: [
                { k: 'service', label: 'Layanan', type: 'text' },
                { k: 'unit', label: 'Satuan', type: 'text' },
                { k: 'price', label: 'Harga (Rp)', type: 'number' },
                { k: 'note', label: 'Catatan', type: 'text' },
              ],
            },
          ],
        },
        {
          key: 'testimonials',
          title: 'Testimoni',
          desc: 'Ulasan pelanggan.',
          fields: [
            { k: 'eyebrow', label: 'Label Atas', type: 'text' },
            { k: 'title', label: 'Judul', type: 'text' },
            { k: 'subtitle', label: 'Sub-judul', type: 'textarea' },
            {
              k: 'items', label: 'Daftar Testimoni', type: 'objArr', addLabel: 'Tambah testimoni', itemLabel: (it: any) => it?.name || '',
              fields: [
                { k: 'name', label: 'Nama', type: 'text' },
                { k: 'role', label: 'Peran / Lokasi', type: 'text' },
                { k: 'star', label: 'Bintang (1-5)', type: 'number' },
                { k: 'text', label: 'Isi Testimoni', type: 'textarea' },
              ],
            },
          ],
        },
        {
          key: 'portfolio',
          title: 'Portofolio',
          desc: 'Galeri dokumentasi pekerjaan.',
          fields: [
            { k: 'eyebrow', label: 'Label Atas', type: 'text' },
            { k: 'title', label: 'Judul', type: 'text' },
            { k: 'note', label: 'Keterangan', type: 'text' },
            {
              k: 'items', label: 'Daftar Portofolio', type: 'objArr', addLabel: 'Tambah gambar', itemLabel: (it: any) => it?.label || '',
              fields: [
                { k: 'src', label: 'Path Gambar', type: 'text' },
                { k: 'alt', label: 'Teks Alt', type: 'text' },
                { k: 'label', label: 'Label', type: 'text' },
              ],
            },
          ],
        },
        {
          key: 'cta',
          title: 'CTA (Ajakan)',
          desc: 'Banner ajakan di bawah halaman.',
          fields: [
            { k: 'title', label: 'Judul', type: 'text' },
            { k: 'subtitle', label: 'Sub-judul', type: 'textarea' },
            { k: 'button', label: 'Teks Tombol', type: 'text' },
          ],
        },
        {
          key: 'footer',
          title: 'Footer',
          desc: 'Bagian bawah halaman.',
          fields: [
            { k: 'about', label: 'Tentang (paragraf)', type: 'textarea' },
            { k: 'hours', label: 'Jam Operasional', type: 'text' },
            { k: 'quickLinksTitle', label: 'Judul Tautan Cepat', type: 'text' },
            { k: 'contactTitle', label: 'Judul Kontak', type: 'text' },
            { k: 'email', label: 'Email', type: 'text' },
            { k: 'rights', label: 'Teks Hak Cipta', type: 'text' },
            { k: 'tagline', label: 'Slogan Bawah', type: 'text' },
            {
              k: 'quickLinks', label: 'Tautan Cepat', type: 'objArr', addLabel: 'Tambah tautan', itemLabel: (it: any) => it?.label || '',
              fields: [
                { k: 'label', label: 'Label', type: 'text' },
                { k: 'href', label: 'Tautan', type: 'text' },
              ],
            },
          ],
        },
      ];

      // ---------- State & render seksi ----------
      const state: Record<string, any> = {};

      function buildState(stored: Record<string, any>) {
        for (const key of Object.keys(DEFAULT_CONTENT)) {
          state[key] = mergeContent(
            JSON.parse(JSON.stringify((DEFAULT_CONTENT as any)[key])),
            stored[key]
          );
        }
      }

      function renderSection(spec: any): HTMLElement {
        const card = el('section', { className: 'overflow-hidden rounded-3xl border border-cool-100 bg-white shadow-sm' });
        const head = el('button', { type: 'button', className: 'flex w-full items-center justify-between gap-3 px-6 py-5 text-left' });
        const txt = el('div', {});
        txt.appendChild(el('h2', { className: 'text-lg font-extrabold tracking-tight text-cool-900' }, [document.createTextNode(spec.title)]));
        txt.appendChild(el('p', { className: 'mt-0.5 text-sm text-cool-600' }, [document.createTextNode(spec.desc)]));
        const chevron = el('span', { className: 'text-cool-400' });
        chevron.textContent = '▾';
        head.append(txt, chevron);
        card.appendChild(head);

        const body = el('div', { className: 'hidden border-t border-cool-100 px-6 py-5' });
        const formEl = el('div', { className: 'space-y-4' });
        renderFields(formEl, state[spec.key], spec.fields);
        body.appendChild(formEl);

        const actions = el('div', { className: 'mt-6 flex items-center gap-3 border-t border-cool-100 pt-4' });
        const saveBtn = el('button', {
          type: 'button',
          className: 'inline-flex items-center gap-2 rounded-full bg-electric-600 px-6 py-2.5 text-sm font-bold text-white transition hover:bg-electric-700',
        });
        saveBtn.textContent = 'Simpan ' + spec.title;
        const status = el('span', { className: 'text-sm text-cool-600' });
        saveBtn.addEventListener('click', () => saveSection(spec, status));
        actions.append(saveBtn, status);
        body.appendChild(actions);
        card.appendChild(body);

        head.addEventListener('click', () => {
          body.classList.toggle('hidden');
          chevron.textContent = body.classList.contains('hidden') ? '▾' : '▴';
        });

        return card;
      }

      async function saveSection(spec: any, status: HTMLElement) {
        if (!supabase) {
          status.textContent = 'Supabase belum dikonfigurasi.';
          return;
        }
        status.textContent = 'Menyimpan…';
        try {
          const { error } = await supabase
            .from('site_content')
            .upsert(
              { section: spec.key, content: state[spec.key], updated_at: new Date().toISOString() },
              { onConflict: 'section' }
            );
          if (error) throw error;
          status.textContent = '✓ Tersimpan';
          toast(spec.title + ' berhasil disimpan');
        } catch (err) {
          console.error(err);
          status.textContent = '✕ Gagal menyimpan';
          toast('Gagal menyimpan: ' + ((err as any)?.message || 'terjadi kesalahan'), false);
        }
      }

      function renderAll() {
        const root = $('dash-sections');
        if (!root) return;
        root.replaceChildren();
        for (const spec of SECTIONS) root.appendChild(renderSection(spec));
      }

      // ---------- Tampilan ----------
      function setView(name: string) {
        ['dash-loading', 'dash-setup', 'dash-login', 'dash-denied', 'dash-editor'].forEach((v) => {
          const elv = $(v);
          elv.classList.add('hidden');
          elv.classList.remove('flex');
        });
        const t = $(name);
        t.classList.remove('hidden');
        if (name === 'dash-loading' || name === 'dash-setup' || name === 'dash-login' || name === 'dash-denied') {
          t.classList.add('flex');
        }
      }

      // ---------- Autentikasi ----------
      $('dash-google-btn')?.addEventListener('click', async () => {
        const err = $('dash-login-error');
        if (!supabase) {
          if (err) {
            err.textContent = 'Supabase belum dikonfigurasi.';
            err.classList.remove('hidden');
          }
          return;
        }
        try {
          const { error } = await supabase.auth.signInWithOAuth({
            provider: 'google',
            options: { redirectTo: authRedirectTo() },
          });
          if (error) throw error;
        } catch (e) {
          console.error(e);
          if (err) {
            err.textContent = describeAuthError(e);
            err.classList.remove('hidden');
          }
        }
      });

      $('dash-logout')?.addEventListener('click', async () => {
        if (supabase) await supabase.auth.signOut();
        window.location.reload();
      });

      // ---------- Inisialisasi ----------
      /**
       * Cek apakah pengguna terdaftar sebagai admin.
       * Basis pertama: RPC is_admin() (fungsi Postgres aman, server-side).
       * Cadangan: cocokkan email di tabel site_admins.
       */
      async function checkAdmin(session: any): Promise<boolean> {
        if (!supabase) return false;
        try {
          const { data, error } = await supabase.rpc('is_admin');
          if (!error) return data === true;
        } catch {
          /* lanjut ke cadangan */
        }
        try {
          const email = String(session?.user?.email || '').toLowerCase();
          if (!email) return false;
          const { data: rows, error: err2 } = await supabase
            .from('site_admins')
            .select('email')
            .eq('email', email);
          if (err2) return false;
          return Array.isArray(rows) && rows.length > 0;
        } catch {
          return false;
        }
      }

      async function init() {
        if (!isSupabaseConfigured || !supabase) {
          setView('dash-setup');
          return;
        }
        try {
          const {
            data: { session },
          } = await supabase.auth.getSession();
          if (!session) {
            setView('dash-login');
            return;
          }

          // Keamanan: hanya akun yang terdaftar sebagai admin yang boleh masuk.
          const isAdmin = await checkAdmin(session);
          if (!isAdmin) {
            // Logout, tampilkan pesan, lalu kembali ke website.
            await supabase.auth.signOut().catch(() => {});
            setView('dash-denied');
            window.setTimeout(() => window.location.replace('/'), 3000);
            return;
          }

          const who = $('dash-user');
          if (who) who.textContent = session.user.email || session.user.id || '';
          setView('dash-editor');

          const { data: rows, error } = await supabase.from('site_content').select('section, content');
          if (error) throw error;
          const stored: Record<string, any> = {};
          (rows || []).forEach((r: any) => (stored[r.section] = r.content));
          buildState(stored);
          renderAll();
        } catch (err) {
          console.error(err);
          setView('dash-login');
        }
      }

      init();
    </script>
  </body>
</html>



