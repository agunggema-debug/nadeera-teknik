      // ---------- State & render seksi ----------
      const state: Record<string, any> = {};

      function buildState(stored: Record<string, any>) {
        for (const key of Object.keys(DEFAULT_CONTENT)) {
          state[key] = mergeContent(
            JSON.parse(JSON.stringify((DEFAULT_CONTENT as any)[key])),
            stored[key]
          );
        }
      }

      function renderSection(spec: any, idx: number): HTMLElement {
        const card = el('section', { className: 'group overflow-hidden rounded-3xl border border-cool-100 bg-white shadow-sm transition hover:border-electric-200 hover:shadow-md' });
        const head = el('button', { type: 'button', className: 'flex w-full items-center gap-4 px-5 py-5 text-left sm:px-6' });
        const num = el('span', { className: 'flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-electric-50 text-sm font-extrabold text-electric-700 ring-1 ring-electric-100' });
        num.textContent = String(idx).padStart(2, '0');
        const txt = el('div', { className: 'min-w-0 flex-1' });
        txt.appendChild(el('h2', { className: 'text-base font-extrabold tracking-tight text-cool-900' }, [document.createTextNode(spec.title)]));
        txt.appendChild(el('p', { className: 'mt-0.5 truncate text-sm text-cool-600' }, [document.createTextNode(spec.desc)]));
        const chevron = el('span', { className: 'flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cool-100 text-cool-600 transition' });
        chevron.textContent = '▾';
        head.append(num, txt, chevron);
        card.appendChild(head);

        const body = el('div', { className: 'hidden border-t border-cool-100 bg-cool-50/40 px-5 py-5 sm:px-6' });
        const formEl = el('div', { className: 'space-y-4' });
        renderFields(formEl, state[spec.key], spec.fields);
        body.appendChild(formEl);

        const actions = el('div', { className: 'mt-6 flex flex-wrap items-center gap-3 border-t border-cool-100 pt-4' });
        const saveBtn = el('button', {
          type: 'button',
          className: 'inline-flex items-center gap-2 rounded-full bg-electric-600 px-6 py-2.5 text-sm font-bold text-white shadow-sm shadow-electric-900/10 transition hover:bg-electric-700 hover:shadow-md active:scale-[0.98]',
        });
        saveBtn.textContent = '✓ Simpan ' + spec.title;
        const status = el('span', { className: 'text-sm font-medium text-cool-600' });
        saveBtn.addEventListener('click', () => saveSection(spec, status));
        actions.append(saveBtn, status);
        body.appendChild(actions);
        card.appendChild(body);

        head.addEventListener('click', () => {
          const open = body.classList.toggle('hidden');
          chevron.textContent = open ? '▾' : '▴';
          if (open) {
            chevron.classList.remove('bg-electric-600', 'text-white');
            chevron.classList.add('bg-cool-100', 'text-cool-600');
          } else {
            chevron.classList.remove('bg-cool-100', 'text-cool-600');
            chevron.classList.add('bg-electric-600', 'text-white');
          }
        });

        // Daftarkan kartu agar bisa di-scroll lewat menu sidebar.
        sectionCards.set(spec.key, card);
        card.id = 'sec-' + spec.key;
        card.classList.add('scroll-mt-20');

        return card;
      }

      async function saveSection(spec: any, status: HTMLElement) {
        if (!supabase) {
          status.textContent = 'Supabase belum dikonfigurasi.';
          return;
        }
        status.textContent = 'Menyimpan…';
        try {
          const { error } = await supabase
            .from('site_content')
            .upsert(
              { section: spec.key, content: state[spec.key], updated_at: new Date().toISOString() },
              { onConflict: 'section' }
            );
          if (error) throw error;
          status.textContent = '✓ Tersimpan';
          toast(spec.title + ' berhasil disimpan');
        } catch (err) {
          console.error(err);
          status.textContent = '✕ Gagal menyimpan';
          toast('Gagal menyimpan: ' + ((err as any)?.message || 'terjadi kesalahan'), false);
        }
      }

      function renderAll() {
        const root = $('dash-sections');
        if (!root) return;
        sectionCards.clear();
        root.replaceChildren();
        for (let i = 0; i < SECTIONS.length; i++) root.appendChild(renderSection(SECTIONS[i], i + 1));
        buildNav();
        renderStats();
      }

      // ---------- Sidebar: daftar kartu & ikon menu ----------
      const sectionCards = new Map<string, HTMLElement>();

      const SECTION_ICONS: Record<string, string> = {
        navigation:
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M3 6h18M3 12h18M3 18h18"/></svg>',
        hero: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>',
        services:
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/></svg>',
        areas: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>',
        pricing:
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>',
        testimonials:
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
        portfolio:
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>',
        cta: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M3 11v3a1 1 0 0 0 1 1h2l3 4V6L6 10H4a1 1 0 0 0-1 1z"/><path d="M18 15a3 3 0 0 0 0-6"/></svg>',
        footer:
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>',
      };

      function buildNav() {
        const nav = $('dash-nav');
        if (!nav) return;
        nav.replaceChildren();
        SECTIONS.forEach((spec, i) => {
          const row = el('button', {
            type: 'button',
            className:
              'group flex w-full items-center gap-3 rounded-xl px-3.5 py-2.5 text-left text-sm font-medium text-electric-200/90 transition hover:bg-white/10 hover:text-white',
          });
          const ic = document.createElement('span');
          ic.className = 'flex h-6 w-6 shrink-0 items-center justify-center';
          ic.innerHTML = SECTION_ICONS[spec.key] || SECTION_ICONS.navigation;
          const num = el('span', {
            className: 'ml-auto rounded-md bg-white/10 px-1.5 py-0.5 text-[10px] font-bold text-electric-200',
          });
          num.textContent = String(i + 1).padStart(2, '0');
          row.appendChild(ic);
          row.appendChild(document.createTextNode(spec.title));
          row.appendChild(num);
          row.addEventListener('click', () => {
            const card = sectionCards.get(spec.key);
            if (card) {
              const body = card.querySelector(':scope > div') as HTMLElement | null;
              if (body && body.classList.contains('hidden')) {
                const head = card.firstElementChild as HTMLElement | null;
                head?.click();
              }
              card.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            closeSidebar();
          });
          nav.appendChild(row);
        });
      }

      // ---------- Statistik ringkas ----------
      function renderStats() {
        const root = $('dash-stats');
        if (!root) return;
        const count = (key: string): number => {
          const v = state[key];
          if (!v) return 0;
          if (Array.isArray(v)) return v.length;
          if (Array.isArray(v.items)) return v.items.length;
          if (Array.isArray(v.rows)) return v.rows.length;
          return 0;
        };
        const cards: { label: string; value: number; color: string; icon: string }[] = [
          { label: 'Bagian Konten', value: SECTIONS.length, color: 'bg-electric-600', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>' },
          { label: 'Layanan', value: count('services'), color: 'bg-accent-500', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/></svg>' },
          { label: 'Estimasi Harga', value: count('pricing'), color: 'bg-electric-800', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>' },
          { label: 'Testimoni', value: count('testimonials'), color: 'bg-emerald-600', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>' },
        ];
        root.replaceChildren();
        cards.forEach((c) => {
          const card = el('div', { className: 'flex items-center gap-3 rounded-2xl border border-cool-100 bg-white p-4 shadow-sm sm:p-5' });
          const tile = el('span', { className: 'flex h-11 w-11 shrink-0 items-center justify-center rounded-xl ' + c.color + ' text-white shadow-sm' });
          tile.innerHTML = c.icon;
          const nums = el('div', {});
          nums.appendChild(el('p', { className: 'text-2xl font-extrabold leading-none tracking-tight text-cool-900' }, [document.createTextNode(String(c.value))]));
          nums.appendChild(el('p', { className: 'mt-1 text-xs font-medium text-cool-600' }, [document.createTextNode(c.label)]));
          card.append(tile, nums);
          root.appendChild(card);
        });
      }

      // ---------- Sidebar (mobile) & profil dropdown ----------
      const sb = $('dash-sidebar');
      const sbOverlay = $('sb-overlay');
      function openSidebar() {
        sb?.classList.remove('-translate-x-full');
        sbOverlay?.classList.remove('hidden');
      }
      function closeSidebar() {
        sb?.classList.add('-translate-x-full');
        sbOverlay?.classList.add('hidden');
      }
      $('sb-toggle')?.addEventListener('click', () => {
        if (sb?.classList.contains('-translate-x-full')) openSidebar();
        else closeSidebar();
      });
      sbOverlay?.addEventListener('click', closeSidebar);

      const profileToggle = $('dash-user-toggle');
      const profileMenu = $('dash-profile-menu');
      profileToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        profileMenu?.classList.toggle('hidden');
      });
      document.addEventListener('click', () => profileMenu?.classList.add('hidden'));

      // ---------- Tampilan ----------
      function setView(name: string) {
        ['dash-loading', 'dash-setup', 'dash-login', 'dash-denied', 'dash-editor'].forEach((v) => {
          const elv = $(v);
          elv.classList.add('hidden');
          elv.classList.remove('flex');
        });
        const t = $(name);
        t.classList.remove('hidden');
        if (name === 'dash-loading' || name === 'dash-setup' || name === 'dash-login' || name === 'dash-denied') {
          t.classList.add('flex');
        }
      }

      // ---------- Autentikasi ----------
      $('dash-google-btn')?.addEventListener('click', async () => {
        const err = $('dash-login-error');
        if (!supabase) {
          if (err) {
            err.textContent = 'Supabase belum dikonfigurasi.';
            err.classList.remove('hidden');
          }
          return;
        }
        try {
          const { error } = await supabase.auth.signInWithOAuth({
            provider: 'google',
            options: { redirectTo: authRedirectTo() },
          });
          if (error) throw error;
        } catch (e) {
          console.error(e);
          if (err) {
            err.textContent = describeAuthError(e);
            err.classList.remove('hidden');
          }
        }
      });

      async function handleLogout() {
        if (supabase) await supabase.auth.signOut();
        // Setelah keluar, arahkan kembali ke halaman website utama.
        window.location.replace('/');
      }
      $('dash-logout')?.addEventListener('click', handleLogout);
      $('dash-logout-side')?.addEventListener('click', handleLogout);

      // ---------- Inisialisasi ----------
      /**
       * Cek apakah pengguna terdaftar sebagai admin.
       * Basis pertama: RPC is_admin() (fungsi Postgres aman, server-side).
       * Cadangan: cocokkan email di tabel site_admins.
       */
      async function checkAdmin(session: any): Promise<boolean> {
        if (!supabase) return false;
        try {
          const { data, error } = await supabase.rpc('is_admin');
          if (!error) return data === true;
        } catch {
          /* lanjut ke cadangan */
        }
        try {
          const email = String(session?.user?.email || '').toLowerCase();
          if (!email) return false;
          const { data: rows, error: err2 } = await supabase
            .from('site_admins')
            .select('email')
            .eq('email', email);
          if (err2) return false;
          return Array.isArray(rows) && rows.length > 0;
        } catch {
          return false;
        }
      }

      async function init() {
        if (!isSupabaseConfigured || !supabase) {
          setView('dash-setup');
          return;
        }
        try {
          const {
            data: { session },
          } = await supabase.auth.getSession();
          if (!session) {
            setView('dash-login');
            return;
          }

          // Keamanan: hanya akun yang terdaftar sebagai admin yang boleh masuk.
          const isAdmin = await checkAdmin(session);
          if (!isAdmin) {
            // Logout, tampilkan pesan, lalu kembali ke website.
            await supabase.auth.signOut().catch(() => {});
            setView('dash-denied');
            window.setTimeout(() => window.location.replace('/'), 3000);
            return;
          }

          const email = session.user.email || session.user.id || '';
          const initial = (email.charAt(0) || '?').toUpperCase();

          const label = $('dash-user-label');
          if (label) label.textContent = email;
          const av = $('dash-avatar');
          if (av) av.textContent = initial;
          const avSide = $('dash-avatar-side');
          if (avSide) avSide.textContent = initial;
          const userSide = $('dash-user-side');
          if (userSide) userSide.textContent = email;
          setView('dash-editor');

          const { data: rows, error } = await supabase.from('site_content').select('section, content');
          if (error) throw error;
          const stored: Record<string, any> = {};
          (rows || []).forEach((r: any) => (stored[r.section] = r.content));
          buildState(stored);
          renderAll();
        } catch (err) {
          console.error(err);
          setView('dash-login');
        }
      }

      init();
    </script>
  </body>
</html>



